# 복사해서 .env.local 로 저장한 뒤 값을 채운다. (.env.local 은 git에 올리지 않음)

# 사이트 주소 (메타데이터·OG 이미지 절대경로용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — 대시보드 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# staging 비밀번호 보호 (Vercel Preview 환경에만 설정. 로컬·운영은 비워 둔다)
# 검색 제외(noindex)는 이 값과 상관없이 Vercel이 넣어 주는 VERCEL_ENV=preview로 판단한다
PREVIEW_PASSWORD=

# 오픈 전 '준비 중' 화면 — Vercel Production 환경에만 true. 오픈 날 지우고 재배포한다
# true면 모든 주소가 주소를 유지한 채 /coming-soon 화면을 보여 준다. 로컬은 비워 둔다
SITE_COMING_SOON=
